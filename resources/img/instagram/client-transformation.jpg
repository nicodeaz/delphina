<svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#FF6B9D;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#FFD700;stop-opacity:1" />
        </linearGradient>
    </defs>
    <rect width="400" height="400" fill="url(#bg)"/>
    <!-- Before/After -->
    <text x="120" y="180" text-anchor="middle" font-family="serif" font-size="18" fill="white" font-weight="bold">BEFORE</text>
    <text x="280" y="180" text-anchor="middle" font-family="serif" font-size="18" fill="white" font-weight="bold">AFTER</text>
    <text x="200" y="250" text-anchor="middle" font-family="serif" font-size="20" fill="white" font-weight="bold">Transformation</text>
    <text x="200" y="290" text-anchor="middle" font-family="sans-serif" font-size="14" fill="white" opacity="0.9">Client Glow Up 🙌</text>
    <!-- Arrow -->
    <text x="200" y="220" text-anchor="middle" font-size="24">➡️</text>
</svg>