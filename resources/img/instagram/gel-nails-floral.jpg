<svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#FF6B9D;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#C77DFF;stop-opacity:1" />
        </linearGradient>
    </defs>
    <rect width="400" height="400" fill="url(#bg)"/>
    <!-- Floral Gel Nails -->
    <text x="200" y="180" text-anchor="middle" font-family="serif" font-size="24" fill="white" font-weight="bold">Floral</text>
    <text x="200" y="210" text-anchor="middle" font-family="serif" font-size="24" fill="white" font-weight="bold">Gel Nails</text>
    <text x="200" y="250" text-anchor="middle" font-family="sans-serif" font-size="14" fill="white" opacity="0.8">Spring Collection 2024</text>
    <!-- Decorative flowers -->
    <circle cx="100" cy="100" r="15" fill="#FFD700" opacity="0.7"/>
    <circle cx="300" cy="120" r="12" fill="#FF6B9D" opacity="0.8"/>
    <circle cx="80" cy="320" r="10" fill="#C77DFF" opacity="0.6"/>
    <circle cx="320" cy="300" r="14" fill="#FFD700" opacity="0.7"/>
</svg>