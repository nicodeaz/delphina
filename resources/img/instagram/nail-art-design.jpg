<svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#C77DFF;stop-opacity:1" />
            <stop offset="50%" style="stop-color:#FF6B9D;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#FFD700;stop-opacity:1" />
        </linearGradient>
    </defs>
    <rect width="400" height="400" fill="url(#bg)"/>
    <text x="200" y="180" text-anchor="middle" font-family="serif" font-size="24" fill="white" font-weight="bold">Custom</text>
    <text x="200" y="210" text-anchor="middle" font-family="serif" font-size="24" fill="white" font-weight="bold">Nail Art</text>
    <text x="200" y="250" text-anchor="middle" font-family="sans-serif" font-size="14" fill="white" opacity="0.9">Your Vision, My Creation 🎨</text>
    <!-- Art tools -->
    <text x="100" y="100" font-size="20">🎨</text>
    <text x="300" y="120" font-size="18">🖌️</text>
    <text x="80" y="320" font-size="16">✏️</text>
    <text x="320" y="300" font-size="19">💅</text>
</svg>